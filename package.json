  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@playwright/test": "^1.48.2",
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.8.4",
    "@types/yargs": "^17.0.33",
    "@unocss/eslint-plugin": "^0.63.6",
    "cilicili": "^0.0.4",
    "eslint": "^9.13.0",
    "eslint-plugin-format": "^0.1.2",
    "playwright": "^1.48.2",
