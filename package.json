{
  "name": "seod",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "description": "Straight eye of death. Find out dead links in your site.",
  "keywords": [
    "seod",
    "check"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "seod-ts": "bin/index.ts",
    "seod": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "demo": "npm run example",
    "demo:app": "pnpm -C examples/app run dev",
    "example": "vite-node examples/check-site.ts",
    "test": "npm run test:e2e",
    "test:e2e": "pnpm exec playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "playwright": "^1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "c12": "^2.0.1",
    "cli-progress": "^3.12.0",
    "consola": "^3.2.3",
    "date-fns": "^4.1.0",
    "fs-extra": "^11.2.0",
    "p-queue": "^8.0.1",
    "strip-ansi": "^7.1.0",
    "winston": "^3.16.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@playwright/test": "^1.48.2",
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.9.0",
    "@types/yargs": "^17.0.33",
    "@unocss/eslint-plugin": "^0.64.0",
    "cilicili": "^0.1.1",
    "eslint": "^9.14.0",
    "eslint-plugin-format": "^0.1.2",
    "playwright": "^1.48.2",
    "tsx": "^4.19.2",
    "unbuild": "^2.0.0",
    "vite-node": "^2.1.4"
  }
}
