{
  "name": "seod",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "description": "Straight eye of death. Find out dead links in your site.",
  "module": "src/index.ts",
  "bin": {
    "seod": "dist/index.mjs"
  },
