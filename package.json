{
  "name": "meodp-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm --filter meodp build",
    "dev": "pnpm --filter meodp dev",
    "dev:client": "pnpm --filter @meodp/client dev",
    "docs:dev": "pnpm --filter @meodp/docs dev",
    "docs:build": "pnpm --filter @meodp/docs build",
    "docs:preview": "pnpm --filter @meodp/docs preview",
    "demo": "pnpm --filter @meodp/example dev",
    "demo:export": "pnpm --filter @meodp/example export",
    "example": "tsx examples/check-site.ts",
    "test": "pnpm --filter meodp test",
    "test:e2e": "pnpm --filter meodp test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm --filter meodp --filter @meodp/docs -r typecheck",
    "release": "pnpm --filter meodp release",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@unocss/eslint-plugin": "^0.64.0",
    "eslint": "^9.14.0",
    "eslint-plugin-format": "^0.1.2",
    "lint-staged": "^15.2.10",
    "meodp": "workspace:*",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.19.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
